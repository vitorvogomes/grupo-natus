type Development = {
  slug: string
  name: string
  status: DevelopmentStatus
  location: Location
  description: string
  images: Image[]
  features: Feature[]
  constructionProgress?: number
  progressUpdatedAt?: string
  map?: MapData
  contact?: ContactData
