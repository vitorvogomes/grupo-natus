# Variáveis de ambiente — Website Grupo Natus
# Copie para .env.local e preencha. NUNCA versione valores reais de secrets.
# Regra do projeto: env/credenciais usados por NOME; valores nunca impressos no contexto.

# Público (client-safe) — botão de WhatsApp (FR6)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-only (definido quando cada feature exigir)
# Provedor de email (FR11, Epic 5) — Resend [ASSUMPTION], a confirmar
# RESEND_API_KEY=
# LEADS_EMAIL_TO=            # caixa que recebe os leads/contatos
# Google Maps (FR7, Epic 3) — só se sair do embed
# GOOGLE_MAPS_API_KEY=
# Supabase (Epic 8, condicional) — preservar RLS/secrets existentes
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Google Maps com o pin da Natus (opcional). Sem as duas, o mapa usa o embed
# público, que não aceita marcador próprio. Passo a passo: docs/google-maps.md
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
